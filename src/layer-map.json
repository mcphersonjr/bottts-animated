{
  "$comment": "Bottts-Neutral Animated v6.2.1 layer contract. Art: remix of Bottts by Pablo Stanley (https://bottts.com/). Style: https://www.dicebear.com/styles/bottts-neutral/. Runtime source of truth is src/createAvatar.js.",
  "style": "bottts-neutral",
  "version": "6.2.1",
  "canvas": {
    "width": 120,
    "height": 120,
    "viewBox": "0 0 120 120"
  },
  "transforms": {
    "eyes": "translate(8 20)",
    "mouth": "translate(26 72)",
    "texture": "translate(-48.5 -9.9)",
    "faceScale": "translate(60 60) scale(S) translate(-60 -60)",
    "faceScaleOrigin": [60, 60],
    "note": "Face scale wraps texture, mouth, and eyes only, and only when scale is not 1. Background stays a full square."
  },
  "layers": {
    "bg": {
      "id": "#bg",
      "animatable": false
    },
    "texture": {
      "id": "#texture",
      "cssClass": ".bn-texture",
      "gate": ".bn-tex-anim",
      "motions": ["texDrift"]
    },
    "mouth": {
      "id": "#mouth",
      "cssClass": ".bn-mouth",
      "gate": ".bn-talk-anim",
      "motions": ["talk"]
    },
    "eyes": {
      "id": "#eyes",
      "svgTransformOnly": true,
      "note": "Official translate stays on #eyes. Motion classes sit on inner groups from enhanceEyeSvg, and only while animating."
    }
  },
